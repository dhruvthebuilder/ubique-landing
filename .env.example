# ─── Server-only (never exposed to the client) ───────────────────────────────

# Anthropic Claude — prompt expansion (Sonnet 4.5)
ANTHROPIC_API_KEY=

# OpenAI — image generation (gpt-image-1)
OPENAI_API_KEY=

# Google Apps Script Web App URL — reservation form sink
FORM_ENDPOINT=

# ─── Public (inlined into static HTML by scripts/inject-keys.ts) ─────────────

# PostHog — product analytics with variant super-property
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Pixel — 15-16 digit number from Events Manager
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads — format: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion label — short string from conversion tag setup
NEXT_PUBLIC_GOOGLE_ADS_LABEL=
