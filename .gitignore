# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude / agent tooling artifacts
.claude/
.kiro/
.agents/
cm.curl
skills-lock.json
ubique-claude-code-brief.md
photos/
platform.openapi.yml

# design sources (kept locally as reference, never shipped)
/design-source/
/Ubique Landing v1/
/ubique-landing-page-v2/

# image generation cache (regenerable)
.image-cache.json

# variant served HTMLs are built fresh from *.template.html on every npm run prebuild
/public/v1/index.html
/public/v2/index.html

# pending-image intake: never committed (raw PNGs/JPGs from manual gen)
/_pending-images/

archive/
